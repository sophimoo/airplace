{
	"schemaVersion": 1,
	"id": "airplace",
	"version": "${version}",
	"name": "AirPlace",
	"description": "Place blocks in mid-air: aim, hold the bind, scroll to adjust the range. Cloth Config screen included.",
	"authors": [
		"Sophie"
	],
	"contact": {},
	"license": "GPL-3.0-or-later",
	"icon": "assets/airplace/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.sophimoo.airplace.AirPlaceClient"
		],
		"modmenu": [
			"com.sophimoo.airplace.AirPlaceModMenu"
		]
	},
	"mixins": [
		{
			"config": "airplace.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "airplace.client.compat.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	}
}
